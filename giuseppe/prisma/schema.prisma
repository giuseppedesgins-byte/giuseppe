// Giuseppe MVP — Prisma schema
// Postgres (Supabase-compatible). Run `npm run db:push` (dev) or `db:migrate` (with migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum BrandStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  REMOVED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  UNPUBLISHED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

enum SellerStanding {
  GOOD_STANDING
  WARNING
  PROBATION
  SUSPENDED
  BANNED
}

enum EnforcementSeverity {
  MINOR
  MODERATE
  SEVERE
}

enum InventoryModel {
  MADE_TO_ORDER
  STOCKED
  BOTH
}

enum ReviewAction {
  APPROVE
  REJECT
  REQUEST_INFO
  NOTE
}

enum MembershipStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

// ---------- Identity ----------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  role          UserRole      @default(CUSTOMER)
  supabaseUid   String?       @unique // links to Supabase Auth user, if used
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?
  admin         Admin?
  sellerAccount SellerAccount?
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Admin {
  id        String              @id @default(cuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime            @default(now())
  reviews   ApplicationReview[]
  enforcementActions EnforcementAction[]
}

// ---------- Brand application (pre-approval) ----------

model BrandApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(PENDING)

  // Founder / business info
  founderName        String
  brandName           String
  legalBusinessName   String?
  email               String
  phone               String?
  country             String
  city                String
  website             String?
  instagram           String?
  tiktok              String?
  otherSocialLinks    String?

  // Brand info
  brandStory       String  @db.Text
  yearFounded      Int?
  productCategories String[]
  targetCustomer   String? @db.Text
  differentiation  String? @db.Text
  whyJoinGiuseppe  String? @db.Text

  // Product verification
  productImageUrls    String[]
  productVideoUrls    String[]
  lookbookUrl         String?
  productDescriptions String? @db.Text
  materials           String? @db.Text
  sizingInfo          String? @db.Text

  confirmProductsReal      Boolean @default(false)
  confirmPhotosAccurate    Boolean @default(false)
  confirmAuthorizedToSell  Boolean @default(false)
  confirmNotCounterfeit    Boolean @default(false)
  confirmInfoTruthful      Boolean @default(false)

  // Fulfillment readiness
  inventoryModel          InventoryModel?
  avgProcessingTime       String?
  avgShippingTime         String?
  countriesShippedTo      String[]
  shippingCarriers        String[]
  trackingProvided        Boolean?
  maxWeeklyOrderCapacity  Int?
  customerSupportEmail    String?
  returnPolicy            String? @db.Text
  refundPolicy            String? @db.Text

  // Manufacturing
  manufacturingLocation String?
  manufacturingType     String? // "in-house" | "third-party" | "both"
  manufacturingNotes    String? @db.Text

  // Agreement checkboxes
  agreeApprovalDiscretion       Boolean @default(false)
  agreeAdditionalVerification   Boolean @default(false)
  agreeRemovalForViolations     Boolean @default(false)
  agreeAccurateRepresentation   Boolean @default(false)
  agreeFulfillmentResponsibility Boolean @default(false)
  agreeMarketplaceRules         Boolean @default(false)

  // Set once approved and a Brand record is created
  brandId String? @unique
  brand   Brand?  @relation(fields: [brandId], references: [id])

  reviews   ApplicationReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationReview {
  id            String            @id @default(cuid())
  applicationId String
  application   BrandApplication  @relation(fields: [applicationId], references: [id])
  adminId       String
  admin         Admin             @relation(fields: [adminId], references: [id])
  action        ReviewAction
  note          String?           @db.Text
  createdAt     DateTime          @default(now())
}

// ---------- Brand (post-approval) ----------

model Brand {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  legalName String?
  status   BrandStatus @default(DRAFT)

  logoUrl      String?
  heroImageUrl String?
  story        String? @db.Text
  country      String?
  city         String?
  website      String?
  instagram    String?
  tiktok       String?

  // Founding Brand program
  foundingBrand                  Boolean   @default(false)
  launchDate                     DateTime?
  promotionRequirementConfirmed  Boolean   @default(false)
  promotionCompleted             Boolean   @default(false)
  promotionUrl                   String?

  // Commission — configurable per brand, defaults to marketplace standard (9.00%)
  commissionBps Int @default(900)

  application      BrandApplication?
  products         Product[]
  shippingOptions  ShippingOption[]
  orders           Order[]
  sellerAccount    SellerAccount?
  membership       Membership?
  sellerPerformance SellerPerformance?
  enforcementActions EnforcementAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerAccount {
  id                       String   @id @default(cuid())
  brandId                  String   @unique
  brand                    Brand    @relation(fields: [brandId], references: [id])
  userId                   String?  @unique
  user                     User?    @relation(fields: [userId], references: [id])
  // FLAG: Stripe Connect account type (Standard vs Express vs Custom) is a business/
  // legal decision — see README. stripeAccountId populated once that decision is made.
  stripeAccountId          String?
  stripeOnboardingComplete Boolean  @default(false)
  payoutEmail              String?
  // FLAG: unguessable-URL "magic link" access, not real authentication. Fine for an MVP
  // seller portal (view orders, add tracking) but replace with real seller login before
  // this token is shared over anything less trusted than a direct admin-to-seller email.
  portalToken              String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  payouts                  Payout[]
}

model Payout {
  id              String   @id @default(cuid())
  sellerAccountId String
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id])
  amountCents     Int
  currency        String   @default("usd")
  status          String   @default("pending") // pending | in_transit | paid | failed
  stripeTransferId String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime @default(now())
}

model Membership {
  id                String            @id @default(cuid())
  brandId           String            @unique
  brand             Brand             @relation(fields: [brandId], references: [id])
  planName          String            @default("founding_brand")
  status            MembershipStatus  @default(TRIAL)
  trialEndsAt       DateTime?
  monthlyPriceCents Int               // configurable — see lib/pricing.ts, not hardcoded in business logic
  commissionBps     Int               @default(900)
  stripeSubscriptionId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SellerPerformance {
  id                 String         @id @default(cuid())
  brandId            String         @unique
  brand              Brand          @relation(fields: [brandId], references: [id])
  totalOrders        Int            @default(0)
  fulfilledOrders    Int            @default(0)
  lateOrders         Int            @default(0)
  cancelledOrders    Int            @default(0)
  refunds            Int            @default(0)
  complaints         Int            @default(0)
  avgFulfillmentHours Float?
  standing           SellerStanding @default(GOOD_STANDING)
  updatedAt          DateTime       @updatedAt
}

model EnforcementAction {
  id        String               @id @default(cuid())
  brandId   String
  brand     Brand                @relation(fields: [brandId], references: [id])
  adminId   String?
  admin     Admin?               @relation(fields: [adminId], references: [id])
  severity  EnforcementSeverity
  reason    String               @db.Text
  action    String // e.g. "Warning issued", "Suspended", "Permanently banned"
  createdAt DateTime             @default(now())
}

// ---------- Catalog ----------

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  brandId     String
  brand       Brand         @relation(fields: [brandId], references: [id])
  name        String
  description String        @db.Text
  priceCents  Int
  currency    String        @default("usd")
  materials   String?       @db.Text
  sizingInfo  String?       @db.Text
  colorOptions String[]
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  newArrival  Boolean       @default(false)

  processingTime String?
  returnPolicy   String? @db.Text
  refundPolicy   String? @db.Text

  images     ProductImage[]
  videos     ProductVideo[]
  categories Category[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  position  Int     @default(0)
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  position  Int     @default(0)
}

model ShippingOption {
  id                String  @id @default(cuid())
  brandId           String
  brand             Brand   @relation(fields: [brandId], references: [id])
  region            String // country name or "ALL" for worldwide
  method            String // e.g. "Standard", "Express"
  costCents         Int
  currency          String  @default("usd")
  estDeliveryDaysMin Int?
  estDeliveryDaysMax Int?
  trackingAvailable Boolean @default(true)
  orders            Order[]
}

// ---------- Orders (one brand per order — see README §Checkout Model) ----------

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  email      String // always stored, even for guest checkout

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  shippingAddress Json
  billingAddress  Json?

  shippingOptionId String?
  shippingOption    ShippingOption? @relation(fields: [shippingOptionId], references: [id])
  shippingMethod    String?
  shippingCostCents Int             @default(0)

  subtotalCents     Int
  commissionBps     Int // snapshot of brand.commissionBps at time of order
  commissionCents   Int
  sellerAmountCents Int
  totalCents        Int
  currency          String @default("usd")

  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  trackingNumber String?
  trackingUrl    String?
  carrier        String?

  // FLAG: Stripe Connect flow (destination charges vs. separate charges/transfers) not
  // yet finalized — see README. These fields support either approach.
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String // snapshot
  unitPriceCents Int    // snapshot
  quantity      Int
  options       Json? // e.g. { size: "M", color: "Black" }
}

// ---------- Misc ----------

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // "footer" | "homepage" | ...
  createdAt DateTime @default(now())
}
