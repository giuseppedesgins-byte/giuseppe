// Giuseppe MVP — Prisma schema
// Postgres (Supabase-compatible). Run `npm run db:push` (dev) or `db:migrate` (with migrations).
//
// NOTE (Aug 2026 update — Master Seller/Product/Inventory/Refund/Accountability system):
// ProductStatus was expanded from {DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, PUBLISHED,
// UNPUBLISHED} to the set below. Mapping for any existing rows: PENDING_APPROVAL ->
// PENDING_REVIEW, PUBLISHED -> LIVE, UNPUBLISHED -> ARCHIVED. If you have real (non-seed)
// products already in the database, re-check their status after running db:push — a Postgres
// enum swap does not auto-translate old values, and `next build`'s `prisma db push
// --accept-data-loss` step will error on rows holding a value no longer in the enum. With
// only seed data so far this is a non-issue; flagging for when real sellers are live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum BrandStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  REMOVED
}

// Full lifecycle for the seller-proposal / admin-gatekeeping product system.
// Only LIVE products are ever shown on any public surface — see lib/queries.ts
// getPublishedProductsWhere(). OUT_OF_STOCK and PENDING_REACTIVATION are completely
// hidden (not "Sold Out" labeled) per explicit business rule.
enum ProductStatus {
  DRAFT                 // seller is still filling out the proposal, not submitted
  PENDING_REVIEW         // submitted by seller, awaiting first admin review
  NEEDS_CHANGES           // admin requested changes; seller can resubmit -> PENDING_REVIEW
  APPROVED                // admin approved but not yet flipped live (rare transitional state)
  LIVE                    // publicly visible and purchasable
  OUT_OF_STOCK             // seller marked out of stock; hidden; no penalty; reversible
  PENDING_REACTIVATION      // seller asked to relist; hidden; requires admin approval -> LIVE
  REJECTED                  // admin rejected the proposal
  ARCHIVED                  // admin took it down permanently (not a seller self-service action)
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  // Never paid, released automatically by lib/order-sweep.ts releaseAbandonedCheckouts()
  // once MarketplaceSettings.abandonedCheckoutMinutes has passed since creation. Distinct
  // from CANCELLED (which always implies a real, paid order someone actively cancelled).
  EXPIRED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
}

// GOOD_STANDING -> WARNING -> PROBATION -> SUSPENDED -> REMOVED/PERMANENTLY_BANNED is the
// normal progression, but serious violations may skip straight to a harsher status — see
// lib/enforcement.ts. Every change is required to carry a reason/administrator/timestamp
// (EnforcementAction row), never a silent status flip.
enum SellerStanding {
  GOOD_STANDING
  WARNING
  PROBATION
  SUSPENDED
  REMOVED
  PERMANENTLY_BANNED
}

enum EnforcementSeverity {
  MINOR
  MODERATE
  SEVERE
}

enum InventoryModel {
  MADE_TO_ORDER
  STOCKED
  BOTH
}

enum ReviewAction {
  APPROVE
  REJECT
  REQUEST_INFO
  NOTE
}

enum MembershipStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

// Who/what performed an audited action — used on both AuditLogEntry (product + order/
// financial actions) and OrderIssue.initiatedBy.
enum ActorType {
  CUSTOMER
  SELLER
  ADMIN
  SYSTEM
  PAYMENT_PROCESSOR
}

enum UpdateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Covers the "Issues/Cases" dashboard — returns, refund requests, non-shipment, delivery
// disputes, defective/misrepresented items, seller-initiated cancellations, counterfeit
// reports (handled with elevated priority, see IssuePriority), and payment disputes/
// chargebacks (architecture wired up, see PaymentDispute + lib/ledger.ts).
enum IssueType {
  RETURN_REQUEST
  REFUND_REQUEST
  NON_SHIPMENT
  DELIVERY_DISPUTE
  DEFECTIVE_OR_MISREPRESENTED
  SUSPECTED_COUNTERFEIT
  SELLER_CANCELLATION
  PAYMENT_DISPUTE
  OTHER
}

enum IssueStatus {
  OPEN
  AWAITING_SELLER
  AWAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

// Internal triage priority — never shown to buyers or sellers. SUSPECTED_COUNTERFEIT and
// PAYMENT_DISPUTE cases default to HIGH/URGENT; everything else defaults to NORMAL.
enum IssuePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Granular state for the physical return-shipment leg of a RETURN_REQUEST case, separate
// from the case's overall IssueStatus (which drives the dashboard for every case type).
enum ReturnShipmentStatus {
  NOT_STARTED
  AWAITING_SHIPMENT
  IN_TRANSIT
  DELIVERED
  INSPECTION_PENDING
  INSPECTION_PASSED
  INSPECTION_FAILED
}

enum ShippingResponsibility {
  BUYER
  SELLER
  GIUSEPPE
}

// Standardized reason codes — stored permanently on every refund/cancellation/issue so
// patterns can be reported on later. Combines the refund-reason list and the
// cancellation-reason list from the spec into one set (both describe "why," so one enum
// avoids a duplicate near-identical model).
enum IssueReasonCode {
  OUT_OF_STOCK_AFTER_PURCHASE
  CUSTOMER_CHANGED_MIND
  CUSTOMER_ORDERED_WRONG_ITEM
  DEFECTIVE_ITEM
  WRONG_ITEM_SHIPPED
  ITEM_NOT_AS_DESCRIBED
  ITEM_DAMAGED_IN_TRANSIT
  NEVER_ARRIVED
  LOST_IN_TRANSIT
  LATE_DELIVERY
  DUPLICATE_ORDER
  PRICING_ERROR
  UNABLE_TO_FULFILL
  QUALITY_ISSUE
  SIZE_FIT_ISSUE
  DUPLICATE_OR_ACCIDENTAL_ORDER
  SUSPECTED_COUNTERFEIT
  COLOR_STYLE_MISMATCH
  MISSING_ITEM
  OTHER
}

// Marketplace-wide numbers Giuseppe can change from /admin/settings without a code
// deploy — see lib/settings.ts. Deliberately a single-row table rather than a generic
// key/value store, so each setting is typed and there's no risk of a typo'd key.
// Existing per-order snapshots (e.g. Order.payoutEligibleAt, OrderIssue.respondByAt) are
// computed from these values AT THE TIME of the relevant event, so changing a setting
// here only affects new orders/cases going forward, not ones already in flight.
model MarketplaceSettings {
  id                         String   @id
  postDeliveryHoldDays       Int      @default(5)
  sellerResponseDeadlineDays Int      @default(3)
  returnWindowDays           Int      @default(14)
  // How long a PENDING_PAYMENT order (Stripe Checkout started, never completed) is allowed
  // to hold its reserved inventory before lib/order-sweep.ts releaseAbandonedCheckouts()
  // expires it and puts the stock back. See lib/order-sweep.ts.
  abandonedCheckoutMinutes   Int      @default(5)
  updatedAt                  DateTime @updatedAt
}

// The seller balance ledger (spec "Seller Balances") — append-only, like AuditLogEntry.
// A seller's balance is never an editable number anywhere in the app; it's always
// computed by summing these rows (see lib/ledger.ts getSellerBalances()). amountCents is
// signed: positive = credit to the seller, negative = debit. status tracks where in the
// payout lifecycle that amount currently sits (PENDING/AVAILABLE/PAID_OUT/REVERSED) —
// this doubles as what the spec calls "PENDING_FUNDS"/"FUNDS_RELEASED" states rather than
// treating those as separate transaction types, to avoid representing the same concept
// two different ways.
model SellerLedgerEntry {
  id          String            @id @default(cuid())
  brandId     String
  brand       Brand             @relation(fields: [brandId], references: [id])
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id])
  type        LedgerEntryType
  amountCents Int
  status      LedgerEntryStatus
  reason      String?
  createdAt   DateTime          @default(now())

  @@index([brandId])
  @@index([orderId])
}

enum LedgerEntryType {
  SALE
  COMMISSION
  PAYOUT
  REFUND
  PARTIAL_REFUND
  REVERSAL
  CHARGEBACK
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  REVERSED
}

// Order-scoped (orderId set) or brand-wide (orderId null, i.e. "suspend all payouts for
// this seller") hold on funds becoming available. A hold on one disputed order never
// freezes unrelated funds unless it's explicitly placed brand-wide. Every hold carries a
// reason, the admin who placed it, and a timestamp — see lib/ledger.ts getSellerBalances(),
// which treats any open hold as blocking release regardless of elapsed time.
model PayoutHold {
  id                 String           @id @default(cuid())
  brandId            String
  brand              Brand            @relation(fields: [brandId], references: [id])
  orderId            String?
  order              Order?           @relation(fields: [orderId], references: [id])
  reason             String           @db.Text
  status             PayoutHoldStatus @default(OPEN)
  placedByAdminId    String
  placedByAdmin      Admin            @relation("PayoutHoldsPlaced", fields: [placedByAdminId], references: [id])
  placedAt           DateTime         @default(now())
  releasedByAdminId  String?
  releasedByAdmin    Admin?           @relation("PayoutHoldsReleased", fields: [releasedByAdminId], references: [id])
  releasedAt         DateTime?
  notes              String?          @db.Text

  @@index([brandId])
  @@index([orderId])
}

enum PayoutHoldStatus {
  OPEN
  RELEASED
}

// Case communication thread for an OrderIssue — separates PUBLIC CASE COMMUNICATION
// (internal = false, visible to the buyer and seller on that case) from GIUSEPPE INTERNAL
// NOTES (internal = true, admin-only, never sent to either party).
model CaseMessage {
  id             String     @id @default(cuid())
  issueId        String
  issue          OrderIssue @relation(fields: [issueId], references: [id])
  senderType     ActorType
  senderLabel    String?
  message        String     @db.Text
  attachmentUrls String[]
  internal       Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([issueId])
}

// ---------- Identity ----------

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  role          UserRole      @default(CUSTOMER)
  supabaseUid   String?       @unique // links to Supabase Auth user, if used
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?
  admin         Admin?
  sellerAccount SellerAccount?
}

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Admin {
  id        String              @id @default(cuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime            @default(now())
  reviews   ApplicationReview[]
  enforcementActions EnforcementAction[]
  reviewedUpdateRequests ProductUpdateRequest[]
  resolvedIssues         OrderIssue[]
  payoutHoldsPlaced      PayoutHold[] @relation("PayoutHoldsPlaced")
  payoutHoldsReleased    PayoutHold[] @relation("PayoutHoldsReleased")
}

// ---------- Brand application (pre-approval) ----------

model BrandApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(PENDING)

  // Founder / business info
  founderName        String
  brandName           String
  legalBusinessName   String?
  email               String
  phone               String?
  country             String
  city                String
  website             String?
  instagram           String?
  tiktok              String?
  otherSocialLinks    String?

  // Brand info
  brandStory       String  @db.Text
  yearFounded      Int?
  productCategories String[]
  targetCustomer   String? @db.Text
  differentiation  String? @db.Text
  whyJoinGiuseppe  String? @db.Text

  // Product verification
  productImageUrls    String[]
  productVideoUrls    String[]
  lookbookUrl         String?
  productDescriptions String? @db.Text
  materials           String? @db.Text
  sizingInfo          String? @db.Text

  confirmProductsReal      Boolean @default(false)
  confirmPhotosAccurate    Boolean @default(false)
  confirmAuthorizedToSell  Boolean @default(false)
  confirmNotCounterfeit    Boolean @default(false)
  confirmInfoTruthful      Boolean @default(false)

  // Fulfillment readiness
  inventoryModel          InventoryModel?
  avgProcessingTime       String?
  avgShippingTime         String?
  countriesShippedTo      String[]
  shippingCarriers        String[]
  trackingProvided        Boolean?
  maxWeeklyOrderCapacity  Int?
  customerSupportEmail    String?
  returnPolicy            String? @db.Text
  refundPolicy            String? @db.Text

  // Manufacturing
  manufacturingLocation String?
  manufacturingType     String? // "in-house" | "third-party" | "both"
  manufacturingNotes    String? @db.Text

  // Agreement checkboxes
  agreeApprovalDiscretion       Boolean @default(false)
  agreeAdditionalVerification   Boolean @default(false)
  agreeRemovalForViolations     Boolean @default(false)
  agreeAccurateRepresentation   Boolean @default(false)
  agreeFulfillmentResponsibility Boolean @default(false)
  agreeMarketplaceRules         Boolean @default(false)

  // Set once approved and a Brand record is created
  brandId String? @unique
  brand   Brand?  @relation(fields: [brandId], references: [id])

  reviews   ApplicationReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationReview {
  id            String            @id @default(cuid())
  applicationId String
  application   BrandApplication  @relation(fields: [applicationId], references: [id])
  adminId       String
  admin         Admin             @relation(fields: [adminId], references: [id])
  action        ReviewAction
  note          String?           @db.Text
  createdAt     DateTime          @default(now())
}

// ---------- Brand (post-approval) ----------

model Brand {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  legalName String?
  status   BrandStatus @default(DRAFT)

  logoUrl      String?
  heroImageUrl String?
  story        String? @db.Text
  country      String?
  city         String?
  website      String?
  instagram    String?
  tiktok       String?

  // Founding Brand program
  foundingBrand                  Boolean   @default(false)
  // Position (1-10) in the public "Our Founding 10" grid. Only shown publicly if the brand is ACTIVE.
  foundingSlot                   Int?      @unique
  launchDate                    DateTime?
  promotionRequirementConfirmed  Boolean   @default(false)
  promotionCompleted             Boolean   @default(false)
  promotionUrl                   String?

  // Commission — configurable per brand, defaults to marketplace standard (9.00%)
  commissionBps Int @default(900)

  application      BrandApplication?
  products         Product[]
  shippingOptions  ShippingOption[]
  orders           Order[]
  sellerAccount    SellerAccount?
  membership       Membership?
  sellerPerformance SellerPerformance?
  enforcementActions EnforcementAction[]
  updateRequests   ProductUpdateRequest[]
  ledgerEntries    SellerLedgerEntry[]
  payoutHolds      PayoutHold[]
  editorialSubject EditorialSubject?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerAccount {
  id                       String   @id @default(cuid())
  brandId                  String   @unique
  brand                    Brand    @relation(fields: [brandId], references: [id])
  userId                   String?  @unique
  user                     User?    @relation(fields: [userId], references: [id])
  // Stripe Connect (Express accounts — decided Aug 2026, see lib/connect.ts). Set once a
  // seller starts onboarding; stripeOnboardingComplete flips true (via the account.updated
  // webhook) once Stripe reports both charges_enabled and payouts_enabled, which is what
  // gates whether /api/checkout routes real money to this account.
  stripeAccountId          String?
  stripeOnboardingComplete Boolean  @default(false)
  payoutEmail              String?
  // FLAG: unguessable-URL "magic link" access, not real authentication. Fine for an MVP
  // seller portal (view orders, add tracking, manage products) but replace with real
  // seller login before this token is shared over anything less trusted than a direct
  // admin-to-seller email.
  portalToken              String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  payouts                  Payout[]
}

model Payout {
  id              String   @id @default(cuid())
  sellerAccountId String
  sellerAccount   SellerAccount @relation(fields: [sellerAccountId], references: [id])
  amountCents     Int
  currency        String   @default("usd")
  status          String   @default("pending") // pending | in_transit | paid | failed
  stripeTransferId String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime @default(now())
}

model Membership {
  id                String            @id @default(cuid())
  brandId           String            @unique
  brand             Brand             @relation(fields: [brandId], references: [id])
  planName          String            @default("founding_brand")
  status            MembershipStatus  @default(TRIAL)
  trialEndsAt       DateTime?
  monthlyPriceCents Int               // configurable — see lib/pricing.ts, not hardcoded in business logic
  commissionBps     Int               @default(900)
  stripeSubscriptionId String?
  // Set the moment a seller completes the Stripe Checkout subscription-setup session (see
  // lib/membership.ts) — used to open the Stripe Billing Portal so a seller can update
  // their card or cancel without Giuseppe building that UI from scratch.
  stripeCustomerId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// totalOrders/fulfilledOrders/etc. are running counters updated by lib/performance.ts
// whenever an order-affecting action happens. cancelledOrders counts ALL cancellations
// regardless of fault; sellerCausedCancellations is the subset the seller is responsible
// for (post-purchase cancellation, not a pre-purchase out-of-stock mark — that never
// touches these metrics at all, per explicit business rule).
model SellerPerformance {
  id                 String         @id @default(cuid())
  brandId            String         @unique
  brand              Brand          @relation(fields: [brandId], references: [id])
  totalOrders        Int            @default(0)
  fulfilledOrders    Int            @default(0)
  lateOrders         Int            @default(0)
  neverShippedOrders Int            @default(0)
  cancelledOrders    Int            @default(0)
  sellerCausedCancellations Int     @default(0)
  refunds            Int            @default(0)
  complaints         Int            @default(0)
  avgFulfillmentHours Float?
  standing           SellerStanding @default(GOOD_STANDING)
  updatedAt          DateTime       @updatedAt
}

model EnforcementAction {
  id        String               @id @default(cuid())
  brandId   String
  brand     Brand                @relation(fields: [brandId], references: [id])
  adminId   String?
  admin     Admin?               @relation(fields: [adminId], references: [id])
  severity  EnforcementSeverity
  reason    String               @db.Text
  action    String // e.g. "Warning issued", "Suspended", "Permanently banned"
  createdAt DateTime             @default(now())
}

// ---------- Catalog ----------

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  brandId     String
  brand       Brand         @relation(fields: [brandId], references: [id])
  name        String
  description String        @db.Text
  priceCents  Int
  currency    String        @default("usd")
  materials   String?       @db.Text
  sizingInfo  String?       @db.Text
  colorOptions String[]
  sizeOptions  String[]
  sku          String?
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  newArrival  Boolean       @default(false)
  // Must be shown prominently on the product page BEFORE purchase (see /products/[slug]).
  // Does NOT waive buyer protection for counterfeit, wrong, materially misrepresented, or
  // damaged-on-arrival items, or items never delivered — see lib/returns.ts isReturnEligible().
  finalSale   Boolean       @default(false)

  // Inventory — null means "not tracked" (made-to-order / unlimited). When set, checkout
  // does a transactional conditional decrement (see /api/checkout) so two customers can't
  // both buy the last unit. Sellers can freely edit this number without triggering
  // re-review (see updateRequests below) — only "material" changes need admin approval.
  inventoryQuantity Int?
  madeToOrder       Boolean @default(false)

  processingTime String?
  returnPolicy   String? @db.Text
  refundPolicy   String? @db.Text

  // Notes, not shown to customers. sellerNote: what the seller told Giuseppe when
  // proposing/updating. adminNote: Giuseppe's internal review notes (rejection reasons,
  // "needs changes" feedback, etc.) — surfaced back to the seller in the portal, but
  // never on the public product page.
  sellerNote String? @db.Text
  adminNote  String? @db.Text
  reviewedAt DateTime?

  images     ProductImage[]
  videos     ProductVideo[]
  categories Category[]
  orderItems OrderItem[]
  updateRequests ProductUpdateRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  position  Int     @default(0)
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  position  Int     @default(0)
}

// A seller proposing a "material" change (price, photos, description, materials,
// variants, processing time) to an already-LIVE product doesn't touch the live listing —
// it creates one of these instead, and the live version stays up until an admin approves
// it (see lib/products.ts applyProductUpdateRequest()). Simple inventory-quantity edits
// and marking out-of-stock/live bypass this and apply immediately (no re-review needed).
model ProductUpdateRequest {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id])
  proposedChanges   Json     // partial snapshot of the fields being proposed
  sellerNote        String?  @db.Text
  status            UpdateRequestStatus @default(PENDING)
  adminNote         String?  @db.Text
  reviewedByAdminId String?
  reviewedByAdmin   Admin?   @relation(fields: [reviewedByAdminId], references: [id])
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?
}

model ShippingOption {
  id                String  @id @default(cuid())
  brandId           String
  brand             Brand   @relation(fields: [brandId], references: [id])
  region            String // country name or "ALL" for worldwide
  method            String // e.g. "Standard", "Express"
  costCents         Int
  currency          String  @default("usd")
  estDeliveryDaysMin Int?
  estDeliveryDaysMax Int?
  trackingAvailable Boolean @default(true)
  orders            Order[]
}

// ---------- Orders (one brand per order — see README §Checkout Model) ----------

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  email      String // always stored, even for guest checkout

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  shippingAddress Json
  billingAddress  Json?

  shippingOptionId String?
  shippingOption    ShippingOption? @relation(fields: [shippingOptionId], references: [id])
  shippingMethod    String?
  shippingCostCents Int             @default(0)

  subtotalCents     Int
  commissionBps     Int // snapshot of brand.commissionBps at time of order
  commissionCents   Int
  sellerAmountCents Int
  totalCents        Int
  currency          String @default("usd")
  // Sales tax/VAT Stripe Tax calculated and collected on this order (0 unless
  // STRIPE_AUTOMATIC_TAX_ENABLED — see lib/stripe.ts isAutomaticTaxEnabled()). Set from
  // the real Stripe-calculated amount once checkout completes (see webhook), NOT known at
  // order-creation time. Deliberately excluded from commissionCents/sellerAmountCents —
  // Giuseppe's commission and the seller's payout are both based on product subtotal only,
  // tax is collected on the customer's behalf and passed through, not marketplace revenue.
  taxCents          Int    @default(0)

  // Populated as refunds happen — see lib/pricing.ts recalculateCommissionAfterRefund().
  // refundedCents accumulates across partial refunds; commissionCents above is always the
  // ORIGINAL commission, so "current retained commission" = commissionCents - (proportional
  // reversal implied by refundedCents / subtotalCents). See AuditLogEntry rows on this order
  // for the exact before/after commission at each refund event.
  refundedCents Int @default(0)
  // Business decision (Aug 2026): Stripe does not return its processing fee to Giuseppe on
  // a refund, so when a refund is the SELLER's fault (see lib/pricing.ts
  // isSellerFaultReasonCode / the explicit sellerFault flag on a resolved OrderIssue), that
  // fee is passed on to the seller by deducting it from sellerAmountCents. Populated with a
  // flat estimate (lib/pricing.ts estimateProcessorFeeCents) since live per-charge Stripe
  // fee data isn't wired up yet — swap in real balance-transaction data later without
  // changing this field's meaning. Null/0 means no fee was ever assessed on this order.
  processorFeeCents Int?

  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  trackingNumber String?
  trackingUrl    String?
  carrier        String?

  // Ship-date tracking for never-shipped flagging. expectedShipDate is set at order
  // creation from the product's processingTime where parseable; shippedAt is stamped the
  // moment fulfillmentStatus flips to SHIPPED (admin or seller action).
  expectedShipDate DateTime?
  shippedAt        DateTime?
  // Set the first time lib/order-sweep.ts flagNeverShippedOrders() counts this order
  // against SellerPerformance.neverShippedOrders, so the lazy sweep never double-counts
  // the same order on a later page load.
  neverShippedFlaggedAt DateTime?

  // Seller-balance timing (spec "Payout Release"). deliveredAt is stamped the moment
  // fulfillmentStatus flips to DELIVERED; payoutEligibleAt is computed at that same moment
  // as deliveredAt + the CURRENT MarketplaceSettings.postDeliveryHoldDays (a snapshot, so
  // changing the setting later doesn't retroactively move dates already set). Funds tied
  // to this order become AVAILABLE once payoutEligibleAt has passed AND there's no open
  // PayoutHold — see lib/ledger.ts getSellerBalances().
  deliveredAt      DateTime?
  payoutEligibleAt DateTime?

  // Stripe Connect: destination charges (decided Aug 2026 — see lib/stripe.ts,
  // lib/connect.ts). These fields hold the session/intent either way (platform-only or
  // routed to a connected account).
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?

  items         OrderItem[]
  issues        OrderIssue[]
  disputes      PaymentDispute[]
  ledgerEntries SellerLedgerEntry[]
  payoutHolds   PayoutHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  productName   String // snapshot
  unitPriceCents Int    // snapshot
  quantity      Int
  options       Json? // e.g. { size: "M", color: "Black" }
}

// Unified case model for the admin "Issues/Cases" dashboard: returns, refund requests,
// non-shipment, delivery disputes, defective/misrepresented items, and seller-initiated
// cancellations (type = SELLER_CANCELLATION). One model instead of several near-identical
// ones per spec's "avoid duplicate models" guidance. sellerFault is left null until an
// admin (or an unambiguous automatic case, like a seller-initiated cancellation) determines
// responsibility — customers never see sellerFault or internal notes.
model OrderIssue {
  id                 String           @id @default(cuid())
  orderId            String
  order              Order            @relation(fields: [orderId], references: [id])
  type               IssueType
  reasonCode         IssueReasonCode?
  status             IssueStatus      @default(OPEN)
  priority           IssuePriority    @default(NORMAL)
  description        String?          @db.Text
  customerEvidenceUrls String[]
  sellerResponse     String?          @db.Text
  sellerEvidenceUrls String[]
  sellerFault        Boolean?
  initiatedBy        ActorType
  refundCents        Int?
  resolution         String?          @db.Text
  resolvedByAdminId  String?
  resolvedByAdmin    Admin?           @relation(fields: [resolvedByAdminId], references: [id])

  // Seller response deadline — computed at case creation as createdAt + the current
  // MarketplaceSettings.sellerResponseDeadlineDays (a snapshot, same reasoning as
  // Order.payoutEligibleAt). Used to flag overdue cases; nothing auto-escalates on it yet.
  respondByAt        DateTime?

  // Return-specific fields — only meaningful when type = RETURN_REQUEST. Kept on the same
  // OrderIssue model rather than a separate Return table (avoids a duplicate, near-identical
  // system) since a return is fundamentally the same "case" concept with a few extra fields.
  returnShipmentStatus         ReturnShipmentStatus?
  returnShippingResponsibility ShippingResponsibility?
  returnTrackingNumber         String?
  returnCarrier                String?
  returnTrackingUrl            String?
  // Snapshot of Product.finalSale at the time this case was opened, so a later change to
  // the product's Final Sale flag never retroactively changes an already-open case's
  // eligibility logic.
  finalSaleAtPurchase          Boolean @default(false)

  messages  CaseMessage[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([orderId])
  @@index([status])
}

// Architecture only — NOT wired to Stripe's dispute/evidence API yet. Chargeback
// responsibility (who absorbs a dispute — Giuseppe as merchant-of-record vs. the seller)
// is a CEO/legal/Stripe-Connect-structure decision, called out in README. This table exists
// so disputes can at least be recorded and tracked once that decision is made.
model PaymentDispute {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  stripeDisputeId String?   @unique
  amountCents     Int
  reason          String?
  status          String    @default("needs_response")
  evidenceDueBy   DateTime?
  outcome         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Immutable-style audit trail for both product status changes and order/financial actions
// (refunds, cancellations, commission reversals). Rows are only ever inserted, never
// updated or deleted by application code — see lib/audit.ts. entityType is "PRODUCT" or
// "ORDER"; entityId is that record's id.
model AuditLogEntry {
  id                    String    @id @default(cuid())
  entityType            String
  entityId              String
  action                String
  previousStatus        String?
  newStatus             String?
  actorType             ActorType
  actorId               String?
  actorLabel            String?
  reason                String?   @db.Text
  notes                 String?   @db.Text
  amountCents           Int?
  commissionBeforeCents Int?
  commissionAfterCents  Int?
  refundCents           Int?
  metadata              Json?
  createdAt             DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Misc ----------

model EmailSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // "footer" | "homepage" | ...
  createdAt DateTime @default(now())
  // Consent + unsubscribe (null on rows created before these fields existed)
  consentAt         DateTime?
  consentText       String?
  unsubscribeToken  String?   @unique
  unsubscribedAt    DateTime?
}


// ---------------------------------------------------------------------------
// THE EDIT — editorial publication
// Editorial subjects (designers/brands/movements) may or may not be Giuseppe marketplace
// partners. A subject is a marketplace partner ONLY if it is linked to a Brand that is ACTIVE.
// Marketplace membership never changes editorial treatment; labels are derived, not typed in.
// ---------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED   // visible publicly once publishedAt <= now (future date = scheduled)
  UNPUBLISHED
}

enum ArticleCategory {
  THE_RADAR
  DESIGNER_STORIES
  CULTURE
  THE_PERSPECTIVE
  GIUSEPPE_NOTES
}

model EditorialSubject {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  location   String?
  bio        String?  @db.Text
  website    String?
  instagram  String?
  imageUrl   String?
  imageCredit String?

  // Set only for designers who are in the Giuseppe marketplace.
  brandId    String?  @unique
  brand      Brand?   @relation(fields: [brandId], references: [id])

  articles   Article[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Article {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  dek         String?         @db.Text   // short standfirst under the headline
  body        String          @db.Text   // lightweight markdown (see src/lib/markdown.tsx)
  category    ArticleCategory
  status      ArticleStatus   @default(DRAFT)
  publishedAt DateTime?
  featured    Boolean         @default(false) // lead cover story on The Edit
  authorName  String?
  issue       Int?            // e.g. 1 = "Issue 001"; optional

  // Optional SEO overrides (fall back to title / dek)
  metaTitle        String?
  metaDescription  String?

  coverImageUrl    String?
  coverImageAlt    String?
  coverImageCredit String?   // photographer / source / licence — required when a cover image is set

  // Extra disclosure shown on the article (e.g. gifted product, paid partnership). Leave blank if none.
  disclosure  String?

  subjects    EditorialSubject[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// Designer-submitted work for editorial consideration. Entirely separate from BrandApplication
// (marketplace): submitting here does not apply to sell, and being accepted to sell does not
// guarantee coverage.
enum SubmissionStatus {
  NEW
  REVIEWED
  ARCHIVED
}

model EditorialSubmission {
  id              String           @id @default(cuid())
  name            String           // person
  brandName       String
  email           String
  website         String?
  instagram       String?
  description     String           @db.Text
  imageLinks      String[]
  rightsConfirmed Boolean          // sender confirms they own/can share what they submitted
  status          SubmissionStatus @default(NEW)
  notes           String?          @db.Text // internal
  createdAt       DateTime         @default(now())
}
